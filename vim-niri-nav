#!/bin/sh
#
# vim-niri-nav - Use the same bindings to move focus between niri windows and
# vim splits. Requires the accompanying vim plugin.

dir="$1"
if [ -n "$2" ]; then
    if [ $2 = "w" ]; then
        custom="or-workspace-"
    elif [ $2 = "m" ]; then
        custom="or-monitor-"
    else
        custom=""
    fi 
fi
timeout="${VIM_NIRI_NAV_TIMEOUT:-0.1s}"

case "$dir" in
up) ;;
right) ;;
down) ;;
left) ;;
*)
  echo "USAGE: $0 up|right|down|left"
  exit 1
  ;;
esac

get_descendant_pids() {
  pid="$1"
  echo "$pid"

  for child in $(pgrep --parent "$pid"); do
    get_descendant_pids "$child"
  done
}

get_tree_ttys() {
  for pid in "$@"; do
    tty="$(readlink "/proc/$pid/fd/0" 2>/dev/null || true)"
    case "$tty" in
    /dev/pts/* | /dev/tty*) echo "$tty" ;;
    esac
  done | sort -u
}

pid_has_tty() {
  pid="$1"
  ttys="$2"
  tty="$(readlink "/proc/$pid/fd/0" 2>/dev/null || true)"
  [ -n "$tty" ] && printf '%s\n' "$ttys" | grep -Fxq "$tty"
}

get_vim_candidate_pids() {
  tree_pids="$1"
  ttys="$2"

  for pid in $tree_pids; do
    if grep -iqE '^g?(view|n?vim?x?)(diff)?$' "/proc/$pid/comm"; then
      if embed_pid="$(pgrep --parent "$pid" --full 'nvim --embed')"; then
        echo "$embed_pid"
      fi
      echo "$pid"
    fi
  done

  for servername_file in "${XDG_RUNTIME_DIR:-/tmp}"/vim-niri-nav.*.servername; do
    [ -e "$servername_file" ] || continue
    pid="${servername_file##*/vim-niri-nav.}"
    pid="${pid%.servername}"
    [ -d "/proc/$pid" ] || continue
    pid_has_tty "$pid" "$ttys" && echo "$pid"
  done
}

with_timeout() {
  if [ -n "$timeout" ] && [ "$timeout" != 0 ] && command -v timeout >/dev/null 2>&1; then
    timeout "$timeout" "$@"
  else
    "$@"
  fi
}

find_nvim_server() {
  pid="$1"

  for root in "${XDG_RUNTIME_DIR:-}" "${TMPDIR:-}/nvim.${USER:-}" "/tmp/nvim.${USER:-}"; do
    [ -n "$root" ] && [ -d "$root" ] || continue
    find "$root" -type s -name "nvim.$pid.*" -print 2>/dev/null | sed -n '1p'
  done | sed -n '1p'
}

vim_remote_expr() {
  if [ "$program" = vim ]; then
    with_timeout vim --servername "$servername" --remote-expr "$@"
  elif [ "$program" = nvim ]; then
    with_timeout nvim --clean --headless --server "$servername" --remote-expr "$@"
  fi
}

if focused_pid="$(niri msg --json focused-window | jq -e '.pid')"; then
  tree_pids="$(get_descendant_pids "$focused_pid")"
  tree_ttys="$(get_tree_ttys $tree_pids)"

  for vim_pid in $(get_vim_candidate_pids "$tree_pids" "$tree_ttys" | sort -u); do
    program=
    servername=
    remote_status=1
    servername_file="${XDG_RUNTIME_DIR:-/tmp}/vim-niri-nav.$vim_pid.servername"
    if [ -r "$servername_file" ]; then
      read -r program servername <"$servername_file"
    fi

    if [ -n "$servername" ]; then
      did_nav_in_vim=$(vim_remote_expr "VimNiriNav('$dir', 1)" 2>/dev/null)
      remote_status=$?
      if [ "$remote_status" -eq 0 ]; then
        [ "$did_nav_in_vim" = "true" ] && exit 0
        [ "$did_nav_in_vim" = "false" ] && break
      fi
    fi

    if [ "${remote_status:-1}" -ne 0 ] && [ "${program:-nvim}" = nvim ]; then
      servername="$(find_nvim_server "$vim_pid")"
      program=nvim

      if [ -n "$servername" ]; then
        did_nav_in_vim=$(vim_remote_expr "VimNiriNav('$dir', 1)" 2>/dev/null)
        remote_status=$?
        if [ "$remote_status" -eq 0 ]; then
          printf '%s %s\n' "$program" "$servername" >"$servername_file" 2>/dev/null
          [ "$did_nav_in_vim" = "true" ] && exit 0
          [ "$did_nav_in_vim" = "false" ] && break
        fi
      fi
    fi
  done
fi

case "$dir" in
up | down)
  niri msg action focus-window-$custom$dir
  ;;
*)
  niri msg action focus-column-$dir
  ;;
esac
